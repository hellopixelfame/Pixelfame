# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay publishable Key ID only — safe for the client. The Key Secret and
# webhook secret are NEVER put here; they're set as Supabase edge function
# secrets instead (see supabase/README.md).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
